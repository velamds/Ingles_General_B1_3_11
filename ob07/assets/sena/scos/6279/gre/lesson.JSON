, "_data": [{"content": "", "type": "text"}], "selected": 0}, {"id": 1, "correct": 1, "_data": [{"content": "saw", "type": "text"}], "selected": 0}], "id": 3, "_data": [{"type": "question", "contents": [{"content": "", "type": "text"}]}, {"type": "post_question", "contents": {"content": "who had a blood disease. ", "type": ""}}, {"content": "secondary_8", "type": "objective"}]}, {"responses": [{"id": 0, "correct": 0, "_data": [{"content": "", "type": "text"}], "selected": 0}, {"id": 1, "correct": 1, "_data": [{"content": "were showing", "type": "text"}], "selected": 0}], "id": 4, "_data": [{"type": "question", "contents": [{"content": "This disease meant that they", "type": "text"}]}, {"type": "post_question", "contents": {"content": "some spontaneous physical alterations.", "type": ""}}, {"content": "secondary_8", "type": "objective"}]}, {"responses": [{"id": 0, "correct": 0, "_data": [{"content": "", "type": "text"}], "selected": 0}, {"id": 1, "correct": 1, "_data": [{"content": "looked", "type": "text"}], "selected": 0}], "id": 5, "_data": [{"type": "question", "contents": [{"content": "Their teeth, for example, became more visible and so they", "type": "text"}]}, {"type": "post_question", "contents": {"content": " as if they had fangs.", "type": ""}}, {"content": "secondary_8", "type": "objective"}]}], "stimuli_ids": [], "id": 10, "template_override": 2}, {"_data": [{"type": "instructions", "contents": []}, {"type": "group", "contents": [{"content": "Quiz", "type": "group_name"}]}, {"content": {"allowed_attempts": 2, "correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}]}, "type": "feedback"}], "type": "RSLT", "questions": [{"responses": [{"id": 0, "correct": 0, "_data": [{"content": "", "type": "text"}], "selected": 0}, {"id": 1, "correct": 1, "_data": [{"content": "", "type": "text"}], "selected": 0}], "id": 0, "_data": [{"type": "question", "contents": [{"content": "", "type": "text"}]}]}], "stimuli_ids": [], "id": 11, "template_override": 1}], "_data": [{"type": "lab_options", "contents": [{"content": true, "type": "has_nav"}, {"content": true, "type": "has_exercise_controls"}]}], "stimuli": [{"id": 0, "template_override": 1, "type": "welcome", "_data": [], "contents": [{}]}, {"type": "video", "_data": [], "title": "", "template_override": 1, "id": 2, "contents": [{"value": {"video_src": "engenn8le11ob07re2vid01", "images": [{"text": "", "image": "", "time": "0", "id": 0}, {"text": "I was watching the movie \u201cDracula\u201d when I realized that there must be a reason that this legend exists. I decided to dig into the origins of Count Dracula. Most of us might have heard stories about Count Dracula. He is the famous scary vampire that comes alive at night and sucks people's blood. The legends tell us that vampires have been around since the Middle Ages. While I was researching, I came across some information about a medical condition that one biochemist in Canada, David Dolphin, says may be the reason that vampire legends began.", "image": "", "time": "100", "id": 1}, {"text": "Dolphin is an expert on a disease in the blood called \"porphyria,\" a disease which causes problems in how red blood cells function. People with porphyria would not be able to go into the sun, or their noses and fingers could fall off. Their lips would also stretch back from their teeth and would make them look as if they had fangs.\nThese days, people who are sick with porphyria can get blood transfusions and do not suffer from the problems of the disease. However, Dolphin believes that people in the Middle Ages may have drunk blood to get better.", "image": "", "time": "33000", "id": 2}, {"text": "People of the Middle Ages were also trying to protect themselves from anything that was different. Imagine seeing these scary-looking people at night! It must have been terrifying! It is no wonder that vampire stories began.<br/>\nShould we feel sorry for vampires instead of frightened? What do you think?", "image": "", "time": "65000", "id": 3}]}, "type": "video"}]}]}], "type": "sena", "_data": [{"type": "metadata", "contents": [{"content": "Strange Stories From the Hospital", "type": "lesson_name"}, {"content": "The Dracula Disease", "type": "unit_name"}, {"content": 7, "type": "position"}, {"content": "stub", "type": "origin"}, {"content": 11, "type": "lesson"}, {"content": "B1.3", "type": "level"}]}, {"type": "achievment_test", "contents": [{"content": "false", "type": "test"}]}, {"type": "objectives", "contents": [{"content": "Describe unusual events in the past through a wider range of B1 language in both work and social contexts.", "type": "primary"}, {"content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_1"}, {"content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_2"}, {"content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_3"}, {"content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_4"}, {"content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_5"}, {"content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_6"}, {"content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_7"}, {"content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_8"}]}, {"content": "engenn8le11ob07re1img01.jpg", "type": "background_image"}, {"type": "learning_points", "contents": [{"content": "Modals for Possibility and Certainty", "type": "heading"}, {"content": "You use modal verbs to add meaning to other verbs. They come before the dictionary form (infinitive without 'to') of the main verb.  Modal verbs can add meaning connected with certainty or possibility. ", "type": "describer"}, {"content": "You can use modals with a variety of verb tenses. You can use them to talk about possible or certain actions in the present, past or future.<br/><br/>Modals have the same form every time regardless the subject. Do not add an -s to the infinitive.   <br/> <br/>You can use modals with the<span class=\"strong\"> Simple Present tense</span>:<br/><br/>  <span class=\"italic\">The medical condition <span class=\"strong\">may be</span> the reason that the legend began</span>.<br/> (Here, the modal may adds the meaning of possibility:<br/>  It is possible that the medical condition is the reason that the legend began.)  ", "type": "text"}, {"content": "You can use modals with <span class=\"strong\">have + past participle</span>:<br/><br/>  <span class=\"italic\">Most of us <span class=\"strong\">might have heard</span>  stories about Count Dracula. </span><br/> (Here, the modal might adds the meaning of possibility: <br/> It is possible that most of us have heard stories about Count Dracula.)<br/><br/>  <span class=\"italic\">It <span class=\"strong\">must have been</span>  terrifying!</span><br/> (Here, the modal must adds the meaning of certainty: <br/> I am certain that it was terrifying.) <br> <br>Modals have the same form every time regardless of the subject. Do not add an -s to the infinitive.", "type": "text"}, {"content": "Most of us might have heard stories about Count Dracula.", "type": "example"}, {"content": "I came across some information about a medical condition that one biochemist says may be the reason that vampire legends began. ", "type": "example"}, {"content": "People with porphyria would not be able to go in the sun, or their noses and fingers could fall off.", "type": "example"}, {"content": "Dolphin believes that people in the Middle Ages may have drunk blood to get better.", "type": "example"}]}, {"type": "learning_points", "contents": [{"content": "The Simple Past and Past Continuous Tense", "type": "heading"}, {"content": "You often use the Simple Past and the Past Continuous tenses together. ", "type": "describer"}, {"content": "You can use the Past Continuous tense to refer to the context of a story. It talks about the \u2018background' action, or the longer action. You use it to talk about an action that was in progress in the past.", "type": "text"}, {"content": "Examples:<br/><span class=\"italic\">People of the Middle Ages <span class=\"strong\">were</span> always <span class=\"strong\">trying</span> to protect themselves from anything that was different.<br/> I <span class=\"strong\">was watching</span> the movie \u201cDracula\u201d</span> ...", "type": "text"}, {"content": "You can use the Simple Past tense to refer to a shorter action that happened in the middle of, or interrupted, the longer action.<br/><br/>  Example:<br/><span class=\"italic\">I <span class=\"strong\">realized</span> that there must be a reason that this legend exists.</span>", "type": "text"}, {"content": "While I was researching, I came across some information about a medical condition.", "type": "example"}, {"content": "People of the Middle Ages were always trying to protect themselves from anything that was different.", "type": "example"}]}, {"type": "target_word", "contents": [{"content": "to dig into", "type": "name"}, {"content": "to try to find information about something", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: I decided to dig into the origins of Count Dracula. ", "type": "example"}, {"content": "engenn8le11ob07aud01", "type": "audio"}]}, {"type": "target_word_describer", "contents": [{"content": "These are words you use to talk about strange medical conditions.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "legend", "type": "name"}, {"content": "an old story about famous people and events in the past which may or may not have existed", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: The legends tell us that vampires have been around since the Middle Ages. ", "type": "example"}, {"content": "engenn8le11ob07aud02", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to suck", "type": "name"}, {"content": "to pull liquid into your mouth by using the muscles in your cheeks and tongue", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: Vampires come alive at night and suck people's blood.", "type": "example"}, {"content": "engenn8le11ob07aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "biochemist", "type": "name"}, {"content": "someone who studies chemical substances and vital processes that occur in living organisms", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: One biochemist in Canada gave a possible reason why vampire legends began.", "type": "example"}, {"content": "engenn8le11ob07aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "red blood cell", "type": "name"}, {"content": "a cell in the blood of vertebrates that carries oxygen and carbon dioxide around the body", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Porphyria is a disease that causes problems in how red blood cells function. ", "type": "example"}, {"content": "engenn8le11ob07aud05", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to stretch back", "type": "name"}, {"content": "to become tight by being pulled backwards", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: The lips of people with porphyria stretch back from their teeth and they look as if they had fangs.", "type": "example"}, {"content": "engenn8le11ob07aud06", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "fangs", "type": "name"}, {"content": "the long pointed teeth that some animals have", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Vampires have sharp fangs.", "type": "example"}, {"content": "engenn8le11ob07aud07", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "lips", "type": "name"}, {"content": "the two fleshy parts or folds forming the outside edges of the mouth ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Their lips would also stretch back from their teeth.", "type": "example"}, {"content": "engenn8le11ob07aud08", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "blood transfusion", "type": "name"}, {"content": "the process of receiving blood into one's body intravenously", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: These days, people who are sick with porphyria can get blood transfusions.", "type": "example"}, {"content": "engenn8le11ob07aud09", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "disease", "type": "name"}, {"content": "an illness that affects people or animals, especially caused by infection", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Porphyria is a disease which causes problems in how red blood cells function.", "type": "example"}, {"content": "engenn8le11ob07aud10", "type": "audio"}]}, {"type": "takeaway_extension", "contents": [{"content": "Think of a legend that you and a friend know (or online go to <span class=\"italic\">europeisnotdead.com</span> and read a legend).", "type": "text"}, {"content": "Tell the story of the legend. (Use past simple and past continuous where possible.)", "type": "text"}, {"content": "Talk about what was happening during the time the legend became popular.", "type": "text"}, {"content": "Talk about what people might have believed around the time that legend became popular.  ", "type": "text"}]}, {"type": "takeaway_assessment", "contents": [{"content": "I retell a legend.", "type": "text"}, {"content": "I talk about what was happening when the legend was popular.", "type": "text"}, {"content": "I  express possibility and certainty about what people might have believed.", "type": "text"}]}]}