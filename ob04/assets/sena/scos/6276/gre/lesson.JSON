e"}]}], "stimuli_ids": [], "id": 10, "template_override": 1}, {"type": "RSLT", "_data": [{"type": "instructions", "contents": []}, {"type": "group", "contents": [{"content": "Quiz", "type": "group_name"}]}, {"content": {"correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "allowed_attempts": 2, "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}]}, "type": "feedback"}], "questions": [{"responses": [{"id": 0, "correct": 0, "_data": [{"content": "", "type": "text"}], "selected": 0}, {"id": 1, "correct": 1, "_data": [{"content": "", "type": "text"}], "selected": 0}], "id": 0, "_data": [{"type": "question", "contents": [{"content": "", "type": "text"}]}]}], "stimuli_ids": [], "id": 11, "template_override": 1}], "_data": [{"type": "lab_options", "contents": [{"content": true, "type": "has_nav"}, {"content": true, "type": "has_exercise_controls"}]}], "stimuli": [{"id": 0, "template_override": 1, "_data": [], "type": "welcome", "contents": [{}]}, {"type": "audio", "_data": [], "title": "", "template_override": 1, "id": 1, "contents": [{"value": {"images": [{"text": "", "image": "engenn8le11ob04re2img05.jpg", "time": "0", "id": 0}, {"text": "<span class=\"strong\">Peter</span>: Morning, Sally. You'll never believe this!<br/>\n<span class=\"strong\">Sally</span>: Hi, Peter. Wow, you look like you've seen a ghost!<br/>\n<span class=\"strong\">Peter</span>: Well, I just saw a dog that looks exactly like the one that I helped return to its owner last week! <br/>\n<span class=\"strong\">Sally</span>: Could you remind me again about that?<br/>\n<span class=\"strong\">Peter</span>: I was walking to work when I noticed a poster for a missing golden retriever. The owner was offering a $500 reward for it. I thought I could use that money to renew my gym membership, so ...", "image": "engenn8le11ob04re2img05.jpg", "time": "100", "id": 1}, {"text": "<span class=\"strong\">Sally</span>: You've been going a lot, haven't you? <br/>\n<span class=\"strong\">Peter</span>: Mmhmm, almost every day. You don't go anymore, do you? <br/>\n<span class=\"strong\">Sally</span>: Yes, I do! I've regained a lot of muscle mass, you know.<br/>\n<span class=\"strong\">Peter</span>: Anyway, I saw the poster and then not ten minutes later, I saw the dog! <br/>\n<span class=\"strong\">Sally</span>: The missing retriever? <br/>\n<span class=\"strong\">Peter</span>: Yeah, so I called the number on the poster and met the owner to return the dog. <br/>\n<span class=\"strong\">Sally</span>: You didn't take the reward, did you?", "image": "engenn8le11ob04re2img01.jpg", "time": "25500", "id": 2}, {"text": "<span class=\"strong\">Peter</span>: Well, the owner seemed like a nice old lady, and I didn't feel right taking the reward ...<br/>\n<span class=\"strong\">Sally</span>: Oh, Peter. You have such a good heart! So, what happened this morning?<br/>\n<span class=\"strong\">Peter</span>: I was walking down here to meet you and out of the blue I heard a dog barking ... I went to check and guess what?<br/>\n<span class=\"strong\">Sally</span>: It was the same dog, wasn't it? <br/>\n<span class=\"strong\">Peter</span>: Not only that, but it was barking early in the morning ...<br/>\n<span class=\"strong\">Sally</span>: So?<br/>\n<span class=\"strong\">Peter</span>: You know the superstition about dogs barking early in the morning, right? It's bad luck, you know ...", "image": "engenn8le11ob04re2img02.jpg", "time": "47500", "id": 3}], "coverimg": "engenn8le11ob04re2img05.jpg", "audiosrc": "engenn8le11ob04re2aud01"}, "type": "slideshow"}]}]}], "type": "sena", "_data": [{"type": "metadata", "contents": [{"content": "Strange Stories From the Hospital", "type": "lesson_name"}, {"content": "Talking to a Stranger", "type": "unit_name"}, {"content": 4, "type": "position"}, {"content": "stub", "type": "origin"}, {"content": 11, "type": "lesson"}, {"content": "B1.3", "type": "level"}]}, {"type": "achievment_test", "contents": [{"content": "false", "type": "test"}]}, {"type": "objectives", "contents": [{"content": "Describe unusual events in the past through a wider range of B1 language in both work and social contexts.", "type": "primary"}, {"content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level.", "type": "secondary_1"}, {"content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level.", "type": "secondary_2"}, {"content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level.", "type": "secondary_3"}, {"content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level.", "type": "secondary_4"}, {"content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level.", "type": "secondary_5"}, {"content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level.", "type": "secondary_6"}, {"content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level.", "type": "secondary_7"}, {"content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level.", "type": "secondary_8"}]}, {"content": "engenn8le11ob04re1img01.jpg", "type": "background_image"}, {"type": "target_word", "contents": [{"content": "you look like you've seen a ghost", "type": "name"}, {"content": "used to mean someone looks scared or shocked", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": " Example: Hi, Peter. Wow, you look like you've seen a ghost!", "type": "example"}, {"content": "engenn8le11ob04aud01", "type": "audio"}]}, {"type": "target_word_describer", "contents": [{"content": "These are words you use to talk about strange events!", "type": "text"}]}, {"type": "learning_points", "contents": [{"content": "The Prefix <span class=\"italic\">Re</span>-", "type": "heading"}, {"content": "A prefix is placed before a root word to make a new word. There are many prefixes in English. <br/> A common prefix is <span class=\"italic\">re-</span> which means <span class=\"strong\">back</span> or <span class=\"strong\">again.</span> ", "type": "describer"}, {"content": "When you add a prefix to a word, it changes the meaning of the root word. Often, it is easy to figure out the meaning of the word if you know the meaning of the root word.<br/><br/>  For example:<br/><br/>  <span class=\"italic\">start</span> ---> <span class=\"italic\">restart </span> (to start again)<br/> <span class=\"italic\">do</span> ---> <span class=\"italic\">redo </span>(to do again)<br/> <span class=\"italic\">turn</span> ---> <span class=\"italic\">return</span> (to turn back)", "type": "text"}, {"content": "When you say words with a prefix, you usually put the stress on the syllable after the prefix. <br/><br/>  Say these words out loud. Think about the pronunciation as you do. <br/><br/>  <span class=\"italic\">re<span class=\"strong\">turn</span><br/> re<span class=\"strong\">new</span><br/> re<span class=\"strong\">ward</span><br/> re<span class=\"strong\">gain</span><br/> re<span class=\"strong\">mind</span><br/> re<span class=\"strong\">triever</span></span>", "type": "text"}, {"content": "I just saw a dog that looks exactly like the one that I helped return to its owner last week!", "type": "example"}, {"content": "Could you remind me again about that?", "type": "example"}, {"content": "I was walking to work when I noticed a poster for a missing golden retriever. ", "type": "example"}, {"content": "I thought I could use that money to renew my gym membership.", "type": "example"}, {"content": "There are some words that begin with the prefix re- that are historic, and so the base word is sometimes difficult to recognize. For example: <br> re+award = reward (award again) <br> re+ mind = remind (bring to mind again)<br>  re+trieve = retrieve (from the French trove to find - find again).", "type": "text"}]}, {"type": "learning_points", "contents": [{"content": "Intonation: When You Are Sure vs. When You Are Checking", "type": "heading"}, {"content": "You use <span class=\"strong\">falling intonation</span> (your voice goes down) to signal that you believe what you said is correct. <br/>  You use <span class=\"strong\">rising intonation</span> (your voice goes up) when you are checking, because you are not sure if you are correct. ", "type": "describer"}, {"content": "These two sentences are the same, but they have slightly different meanings as they are said differently, depending on the speaker's intention.<br/><br/>  Try reading them out loud. Put falling intonation at the end of the first one. Put rising intonation at the end of the second one.<br/><br/>  1. <span class=\"italic\">You didn't take the reward, did you?</span> \u2935<br/> I'm sure you didn't take the reward. I know you didn't.<br/><br/>  2. <span class=\"italic\">You didn't take the reward, did you?</span> \u2934 <br/> I'm not sure if you took the reward. I'm checking to see if I'm right.", "type": "text"}, {"content": "Try saying these sentences with both rising and falling intonation:<br/><br/>  <span class=\"italic\">You've been going a lot, haven't you? <br/> You don't go anymore, do you? <br/> It was the same dog, wasn't it? <br? Could you send me the information again, please? </span>", "type": "text"}, {"content": "Remember that : </li><li><span class=\"strong\">Yes/No questions</span> have a rising intonation, like: <span class=\"italic\">Could you send me the information again, please?</span>  \u2934<br> .</li><li><span class=\"strong\"> Information questions</span> and <span class=\"strong\">statements</span> have a falling intonation, like: <span class=\"italic\">Where is it?</span> \u2935and <span class=\"italic\">That's not what I meant.</span> \u2935</span>", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "You'll never believe this!", "type": "name"}, {"content": "used to call people's attention to a particular subject, especially if something is hard to believe", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: You'll never believe this! I saw a dog that looked like the one I helped find its owner.", "type": "example"}, {"content": "engenn8le11ob04aud02", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "reward", "type": "name"}, {"content": "an amount of money offered for finding lost property or a criminal", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: The owner was offering a $500 reward for the dog.", "type": "example"}, {"content": "engenn8le11ob04aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "golden retriever", "type": "name"}, {"content": "a breed of dog whose golden fur is thick, and wavy; known for retrieving objects", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: I noticed a poster for a missing golden retriever.", "type": "example"}, {"content": "engenn8le11ob04aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to renew", "type": "name"}, {"content": "to extend the duration of a contract or a licence", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: I thought I could use that money to renew my gym membership.", "type": "example"}, {"content": "engenn8le11ob04aud05", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "out of the blue", "type": "name"}, {"content": "used to mean that something happens unexpectedly", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: I was walking to meet you and out of the blue I heard a dog barking.", "type": "example"}, {"content": "engenn8le11ob04aud06", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to bark", "type": "name"}, {"content": "for a dog, to produce a short, sharp cry", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: I heard a dog barking in the middle of the night.", "type": "example"}, {"content": "engenn8le11ob04aud07", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "superstition", "type": "name"}, {"content": "an irrational or inexplicable belief in something", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: You know the superstition about dogs barking early in the morning.", "type": "example"}, {"content": "engenn8le11ob04aud08", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to regain", "type": "name"}, {"content": "to get something you have lost back, especially an ability or quality", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: Yes, I do! I've regained a lot of muscle mass.", "type": "example"}, {"content": "engenn8le11ob04aud09", "type": "audio"}]}, {"type": "takeaway_extension", "contents": [{"content": "Go online and find at least 6 more <span class=\"italic\">re+</span>verb words in an English dictionary.", "type": "text"}, {"content": "Read the definitions and write them down.", "type": "text"}, {"content": "Write your own example sentence with each of the six new words.", "type": "text"}, {"content": "Read the sentences aloud to a partner using careful pronunciation.", "type": "text"}]}, {"type": "takeaway_assessment", "contents": [{"content": "I find new <span class=\"italic\">re+</span>verb words.", "type": "text"}, {"content": "I read the definitions.", "type": "text"}, {"content": "I write my own example sentences.", "type": "text"}, {"content": "I say and pronounce words like <span class=\"italic\">renew</span>.", "type": "text"}]}]}