on", "contents": [{"type": "text", "content": "When using any public system of transport,"}]}, {"type": "objective", "content": "secondary_8"}]}, {"responses": [{"correct": 0, "_data": [{"type": "text", "content": ""}], "selected": 0, "id": 0}, {"correct": 1, "_data": [{"type": "text", "content": "might be more comfortable for everyone around."}], "selected": 0, "id": 1}], "id": 1, "_data": [{"type": "question", "contents": [{"type": "text", "content": "Speaking on the phone with a moderate tone"}]}, {"type": "objective", "content": "secondary_8"}]}, {"responses": [{"correct": 0, "_data": [{"type": "text", "content": ""}], "selected": 0, "id": 0}, {"correct": 1, "_data": [{"type": "text", "content": "if we weren't so selfish."}], "selected": 0, "id": 1}], "id": 2, "_data": [{"type": "question", "contents": [{"type": "text", "content": "The world could be a better place to live in"}]}, {"type": "objective", "content": "secondary_8"}]}], "template_override": 1, "id": 10, "_data": [{"type": "instructions", "contents": [{"type": "text", "content": "These are good ideas to think about."}]}, {"type": "group", "contents": [{"type": "group_name", "content": "Quiz"}]}, {"type": "feedback", "content": {"allowed_attempts": 2, "correct_feedback": "Correct!", "attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}]}}, {"type": "post_instructions", "contents": [{"type": "text", "content": "Instructions: Move the words up or down <span class=\"sena-icon sena-icon-vertical-drag\"></span> to complete each sentence."}]}]}, {"stimuli_ids": [], "type": "RSLT", "questions": [{"responses": [{"correct": 0, "_data": [{"type": "text", "content": ""}], "selected": 0, "id": 0}, {"correct": 1, "_data": [{"type": "text", "content": ""}], "selected": 0, "id": 1}], "id": 0, "_data": [{"type": "question", "contents": [{"type": "text", "content": ""}]}]}], "template_override": 1, "id": 11, "_data": [{"type": "instructions", "contents": []}, {"type": "group", "contents": [{"type": "group_name", "content": "Quiz"}]}, {"type": "feedback", "content": {"allowed_attempts": 2, "correct_feedback": "Correct!", "attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}]}}]}], "type": "scholar", "_data": [{"type": "lab_options", "contents": [{"type": "has_nav", "content": true}, {"type": "has_exercise_controls", "content": true}]}], "id": 0, "stimuli": [{"type": "welcome", "template_override": 1, "_data": [], "id": 0, "contents": [{}]}, {"contents": [{"type": "slideshow", "value": {"coverimg": "engenn8le11ob05re2img01.jpg", "audiosrc": "engenn8le11ob05re2aud01", "images": [{"time": "0", "image": "engenn8le11ob05re2img01.jpg", "text": "", "id": 0}, {"time": "100", "image": "engenn8le11ob05re2img01.jpg", "text": "<span class=\"strong\">Interviewer</span>: Good morning, Mr. Rose, I'm Francis Burton with Mystery Magazine. Thank you for speaking with me. <br/>\n<span class=\"strong\">Brian Rose</span>: The pleasure is mine. I was just reading your latest edition. I'm a big fan.<br/>\n<span class=\"strong\">Interviewer</span>: Oh, thank you. Mr. Rose, you are the owner of the Q Hotel which people have heard of thanks to rumors of a supernatural presence. In the words of one past guest, \"It's a nice place to stay, even though there are ghosts!\" Could you touch on that?", "id": 1}, {"time": "27500", "image": "engenn8le11ob05re2img02.jpg", "text": "<span class=\"strong\">Brian Rose</span>: Yes. It's true that the hotel is haunted, although the ghosts are harmless. About 20 years ago, a mother and daughter died in a fire while they were staying in room 609. They had run away with each other and were hiding out in the hotel. The owner at that time backed out of a promise to keep them safe and told people they were there. It was never proven, but people believe the fire was meant for them. Sometimes, out of nowhere, we might see them in the halls or you may hear laughter emanating from room 609.", "id": 2}, {"time": "63000", "image": "engenn8le11ob05re2img03.jpg", "text": "<span class=\"strong\">Interviewer</span>: Does anyone ever check in to room 609?<br/>\n<span class=\"strong\">Brian Rose</span>: I keep the room closed, because I want people to have a peaceful stay. But the ghosts don't hurt anybody. Guests stay at my hotel because they could come across the ghosts. <br/>\n<span class=\"strong\">Interviewer</span>: Well, I'm sure our readers must be curious to experience this for themselves. Mr. Rose, thank you for your time. And stay safe!", "id": 3}]}}], "template_override": 1, "title": "", "type": "audio", "id": 1, "_data": []}]}], "_data": [{"type": "metadata", "contents": [{"type": "lesson_name", "content": "Strange Stories From the Hospital"}, {"type": "unit_name", "content": "A Ghost in the Hospital"}, {"type": "position", "content": 5}, {"type": "origin", "content": "stub"}, {"type": "lesson", "content": 11}, {"type": "level", "content": "B1.3"}]}, {"type": "achievment_test", "contents": [{"type": "test", "content": "false"}]}, {"type": "objectives", "contents": [{"type": "primary", "content": "Describe unusual events in the past through a wider range of B1 language in both work and social contexts."}, {"type": "secondary_1", "content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level. "}, {"type": "secondary_2", "content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level. "}, {"type": "secondary_3", "content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level. "}, {"type": "secondary_4", "content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level. "}, {"type": "secondary_5", "content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level. "}, {"type": "secondary_6", "content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level. "}, {"type": "secondary_7", "content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level. "}, {"type": "secondary_8", "content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level. "}]}, {"type": "background_image", "content": "engenn8le11ob05re1img01.jpg"}, {"type": "learning_points", "contents": [{"type": "heading", "content": "Inseparable Phrasal Verbs"}, {"type": "describer", "content": "Phrasal verbs are two-part verbs consisting of a verb followed by an adverb particle (these look like prepositions, but do not have the same function in phrasal verbs).<br/> In some cases, it is not possible to separate the verb and the particle. These are called <span class=\"italic\">inseparable</span> phrasal verbs."}, {"type": "text", "content": "It is important to remember that the meaning of a phrasal verb is often very different from the two parts taken separately.<br/><br/> For example: <br/> <span class=\"italic\">Matt <span class=\"strong\">turned up</span> last night</span> (= appeared, not the same as turned + up).<br/><br/>  <span class=\"italic\">To turn up</span> is an inseparable phrasal verb. You cannot put an object between the verb and the particle. It must remain together. <br/><br/> Another example is <span class=\"italic\">to get off</span>. <br/> You can say \u201c<span class=\"italic\"><span class=\"strong\">get off</span> the bus</span>\u201d, but you cannot say \u201c<span class=\"italic\"><span class=\"strong\">get</span> the bus <span class=\"strong\">off</span></span>\u201d."}, {"type": "text", "content": "A few verbs can be used with both a particle and a preposition, making them <span class=\"strong\">three-part verbs</span>.<br/><br/> For example:<br/> <span class=\"italic\">to run away with</span> (to leave; to escape from)<br/> <span class=\"italic\">to watch out for</span> (to be careful for)<br/> <br/>  Learning phrasal verbs is a lot like learning new vocabulary. You must memorize which phrasal verbs are inseparable and learn their meanings. <br/><br/>  Look at the chart for some more inseparable phrasal verbs and their meanings."}, {"type": "table", "content": "{\"rows\":9,\"columns\":4,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Phrasal Verb\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Meaning\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Phrasal Verb\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Meaning\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">come across</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"find accidentally\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">hear of </span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"learn about (sometimes accidentally)\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">come by</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"find accidentally\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">check in </span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"register at a hotel\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">turn into</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"become\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">back out of</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"fail to keep a promise\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">touch on</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"mention briefly\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">run away with</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"leave; escape from\\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}"}, {"type": "example", "content": "You are the owner of the Q Hotel which people have heard of thanks to rumors of a supernatural presence."}, {"type": "example", "content": "Could you touch on that?"}, {"type": "example", "content": "The owner at that time backed out of a promise to keep them safe."}, {"type": "example", "content": "They had run away with each other."}]}, {"type": "learning_points", "contents": [{"type": "heading", "content": "The Simple Past and The Past Continuous Tenses"}, {"type": "describer", "content": "You often use the Simple Past and the Past Continuous tenses together."}, {"type": "text", "content": "You can use the Past Continuous tense to refer to the context of a story. It talks about the \u2018background' action, or the longer action. You use it to talk about an action that was in progress in the past.<br/><br/>  <span class=\"italic\">I <span class=\"strong\">was</span> just <span class=\"strong\">reading</span> the latest edition of Mystery Magazine.<br/> While <span class=\"strong\">they were staying</span> in room 609 ...</span><br/><br/>   You can use the Simple Past tense to refer to a shorter action that happened in the middle of, or interrupted, the longer action.<br/><br/>  <span class=\"italic\">A mother and daughter <span class=\"strong\">died</span> in a fire ... <br/>The owner <span class=\"strong\">told</span> people they were there.</span>"}, {"type": "example", "content": "About 20 years ago, a mother and daughter died in a fire while they were staying in room 609."}, {"type": "example", "content": "They were hiding out in the hotel."}, {"type": "example", "content": "I was just reading your latest edition."}]}, {"type": "target_word", "contents": [{"type": "name", "content": "rumor"}, {"type": "definition", "content": "a story that lacks solid basis and is unlikely to be true"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: People have heard of rumors of a supernatural presence."}, {"type": "audio", "content": "engenn8le11ob05aud01"}]}, {"type": "target_word_describer", "contents": [{"type": "text", "content": "These are words you use to talk about strange events."}]}, {"type": "target_word", "contents": [{"type": "name", "content": "supernatural"}, {"type": "definition", "content": "related to what is beyond natural or difficult to explain by natural law"}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: People talk about a supernatural presence in the hotel."}, {"type": "audio", "content": "engenn8le11ob05aud02"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "presence"}, {"type": "definition", "content": "a spirit that cannot be seen but is felt to be near"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: There is a supernatural presence in the hotel."}, {"type": "audio", "content": "engenn8le11ob05aud03"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "ghost"}, {"type": "definition", "content": "the spirit of a dead person which some people think they can feel or see in a place"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: Guests could come across the ghosts at my hotel."}, {"type": "audio", "content": "engenn8le11ob05aud04"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "harmless"}, {"type": "definition", "content": "without the power to hurt anyone"}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: The hotel is haunted, although the ghosts are harmless."}, {"type": "audio", "content": "engenn8le11ob05aud05"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "haunted"}, {"type": "definition", "content": "inhabited or visited by ghosts"}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: The hotel is said to be haunted."}, {"type": "audio", "content": "engenn8le11ob05aud06"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "out of nowhere"}, {"type": "definition", "content": "appears suddenly; without warning"}, {"type": "part_speech", "content": "(expression)"}, {"type": "example", "content": "Example: Sometimes, out of nowhere, we see ghosts in the halls of the hotel."}, {"type": "audio", "content": "engenn8le11ob05aud07"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to emanate"}, {"type": "definition", "content": " to come from a particular place"}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": " Example: You may hear laughter emanating from room 609."}, {"type": "audio", "content": "engenn8le11ob05aud08"}]}, {"type": "takeaway_extension", "contents": [{"type": "text", "content": "Go online and find a ghost story from an English-speaking country."}, {"type": "text", "content": "Read the story and take some notes."}, {"type": "text", "content": "Retell the story to a friend."}, {"type": "text", "content": "Discuss with a friend whether or not you believe the story."}]}, {"type": "takeaway_assessment", "contents": [{"type": "text", "content": "I read a ghost story."}, {"type": "text", "content": "I retell the story using past tenses."}, {"type": "text", "content": "I discuss the strange coincidence or event."}]}]}