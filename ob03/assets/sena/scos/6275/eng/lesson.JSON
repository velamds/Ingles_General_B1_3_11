ills", "contents": [{"content": "Reading", "type": "skill"}]}], "id": 10, "stimuli_ids": []}, {"template_override": 1, "type": "RSLT", "questions": [{"responses": [{"correct": 0, "_data": [{"content": "", "type": "text"}], "selected": 0, "id": 0}, {"correct": 1, "_data": [{"content": "", "type": "text"}], "selected": 0, "id": 1}], "_data": [{"type": "question", "contents": [{"content": "", "type": "text"}]}], "id": 0}], "_data": [{"type": "instructions", "contents": []}, {"type": "group", "contents": [{"content": "Quiz", "type": "group_name"}]}, {"content": {"allowed_attempts": 2, "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}]}, "type": "feedback"}], "id": 11, "stimuli_ids": []}], "type": "scholar", "stimuli": [{"template_override": 1, "type": "welcome", "_data": [], "contents": [{}], "id": 0}, {"template_override": 1, "type": "audio", "id": 1, "title": "", "contents": [{"type": "slideshow", "value": {"audiosrc": "engenn8le11ob03re2aud01", "coverimg": "engenn8le11ob03re2img02.jpg", "images": [{"image": "engenn8le11ob03re2img02.jpg", "text": "", "time": "0", "id": 0}, {"image": "engenn8le11ob03re2img02.jpg", "text": "Child Is Saved by Puppies<br/><br/>This might be the most uncanny, but most heartwarming story of the year so far. It's the kind of story that leaves you baffled and perplexed - but in a good way! A five-year-old girl was found safe and sound 12 hours after she had disappeared from her home in St. Simon. She was saved from freezing to death by snuggling with three puppies until she was found the next day.", "time": "100", "id": 1}, {"image": "engenn8le11ob03re2img01.jpg", "text": "Lily Jackson had wandered away from her home on Friday afternoon. She was looking for her puppy who had run into a field near her house. She had worn light clothing and did not have gloves or a hat with her. When her mother found her on Saturday afternoon, Lily was curled up with Muffy, Ruffles, and Pluto, three of her four puppies.", "time": "27000", "id": 2}, {"image": "engenn8le11ob03re2img03.jpg", "text": "Lily's mother, Sarah, is convinced that her daughter would have frozen if it hadn't been for the puppies who stayed with her all through the night and kept her warm. Now Lily is doing well, with only a few scratches on her face. But it could have been a real tragedy and it must have been very scary.<br/>\nLily decided she may become a vet when she gets older to honor those extraordinary animals that saved her life.", "time": "48000", "id": 3}]}}], "_data": []}, {"template_override": 1, "type": "static", "id": 2, "title": "", "contents": [{"type": "img", "value": "engenn8le11ob03re6img01.jpg"}, {"type": "img", "value": "engenn8le11ob03re6img02.jpg"}], "_data": []}], "_data": [{"type": "lab_options", "contents": [{"content": true, "type": "has_nav"}, {"content": true, "type": "has_exercise_controls"}]}], "id": 0}], "type": "sena"}